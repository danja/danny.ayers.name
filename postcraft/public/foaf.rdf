  <doap:Project rdf:about="#jigdaw">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Project"/>
    <doap:name>JigDAW</doap:name>
    <doap:shortdesc xml:lang="en">A plugin format native to the web, with a browser DAW host; plugins also load natively as VST3, CLAP or LV2.</doap:shortdesc>
    <doap:homepage rdf:resource="https://danja.github.io/jigdaw/"/>
    <doap:repository>
      <doap:GitRepository rdf:nodeID="n700155780abe4184ad4c0fd06c000d28b13">
        <doap:location rdf:resource="https://github.com/danja/jigdaw"/>
      </doap:GitRepository>
    </doap:repository>
    <doap:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
    <doap:programming-language>JavaScript</doap:programming-language>
    <doap:programming-language>C++</doap:programming-language>
    <doap:implements>
      <bibo:Standard rdf:about="#spec-jigdaw">
        <dcterms:title>JigDAW: a web-native audio plugin specification</dcterms:title>
        <dcterms:description xml:lang="en">A plugin is a URL: dereference it for an RDF profile (transmissions, jig: and LV2 vocabularies) and a WebAssembly module that runs in the browser.</dcterms:description>
        <dcterms:creator rdf:resource="#me"/>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcterms:issued>
        <dcterms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/stuff/jigdaw/"/>
        <foaf:page rdf:resource="https://danja.github.io/jigdaw/"/>
      </bibo:Standard>
    </doap:implements>
    <foaf:page rdf:resource="https://strandz.it/jigdaw/"/>
    <doap:developer rdf:resource="#me"/>
  </doap:Project>
