          </foaf:Person>
        </mo:member>
        <foaf:member rdf:resource="#me"/>
        <foaf:member rdf:resource="#nigel"/>
        <foaf:page rdf:resource="https://nocturnalemissions.bandcamp.com/album/the-pump"/>
        <schema:foundingDate>1977</schema:foundingDate>
      </mo:MusicGroup>
    </foaf:maker>
