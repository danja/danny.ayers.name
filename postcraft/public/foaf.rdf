  <mo:Record rdf:about="#the-pump-1980">
    <dcterms:title>The Pump</dcterms:title>
    <dcterms:description xml:lang="en">Recorded 1980, remastered 2009. Danny (credited as Daniel Ayers): synth, guitar, voice.</dcterms:description>
    <foaf:maker>
      <mo:MusicGroup rdf:about="#the-pump">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Group"/>
        <foaf:name>The Pump</foaf:name>
        <dcterms:description xml:lang="en">Experimental group formed in 1977: heavy bass, distorted guitar, cut-up tapes. Cassette-only releases; 1980 sessions reissued on CD by Klanggalerie (2009).</dcterms:description>
        <mo:member rdf:resource="#me"/>
        <mo:member rdf:resource="#nigel"/>
        <mo:member>
          <foaf:Person rdf:nodeID="n700155780abe4184ad4c0fd06c000d28b8">
